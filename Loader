-- CORE: CODE EXTRACTION
----------------------------------------------------------------
local CODE_PATTERNS = {
    "code%s+is%s*[:%s]*([A-Z][A-Z0-9_%-]{3,24})",
    "use%s+code[:%s]+([A-Z][A-Z0-9_%-]{3,24})",
    "redeem[:%s]+([A-Z][A-Z0-9_%-]{3,24})",
    "new%s+code[:%s]*([A-Z][A-Z0-9_%-]{3,24})",
    "sammy[:%s]+([A-Z][A-Z0-9_%-]{3,24})",
    "🎩%s*([A-Z][A-Z0-9_%-]{3,24})",
}

local BLACKLIST = {
    "BRAINROT","STEAL","PLAYER","LOCAL","FRAME","LABEL",
    "BUTTON","IMAGE","SCRIPT","MODEL","PART","UNION",
    "TOOL","MESH","DECAL","SOUND","WELD","BODY","HINT",
    "BILLBOARD","SURFACE","SCREEN","FOLDER","VALUE",
    "HUMANOID","ANIMATE","IDLE","WALK","RUN","JUMP",
    "TUNAI","MULTI","AREA","CASH","COIN","GEM","ITEM",
    "CHAT","TEXT","GAME","WORK","SPACE","CORE","GUI",
    "CLAIM","EVENT","SERVICE","REMOTE","PACKAGE",
}

local function isBlacklisted(code)
    for _,word in ipairs(BLACKLIST) do
        if code==word or code:find(word) then return true end
    end
    return false
end

local function extractCode(text)
    if not text or text=="" then return nil end
    local upper = text:upper()
    local hasKw = upper:find("CODE") or upper:find("REDEEM") or upper:find("SAMMY") or upper:find("🎩")
    if not hasKw then return nil end
    for _,pat in ipairs(CODE_PATTERNS) do
        local m = upper:match(pat)
        if m then
            m = m:gsub("%s+","")
            if #m>=4 and #m<=25 and not isBlacklisted(m) then return m end
        end
    end
    return nil
end

