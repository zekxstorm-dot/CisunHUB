-- CORE: PROCESS TEXT
----------------------------------------------------------------
local function processText(text)
    if not State.enabled then return end
    if not text or #text<7 or #text>120 then return end
    local code = extractCode(text)
    if not code or State.seen[code] then return end
    State.captured = State.captured+1
    setStats()
    pushLog("CAPTURED: "..code, Theme.AccentSoft)
    table.insert(State.partBuffer, code)
    if #State.partBuffer >= State.partTarget then
        local finalCode = State.partBuffer[#State.partBuffer]
        State.partBuffer = {}
        if State.autoSubmit then
            task.spawn(function() submitCode(finalCode) end)
        end
    end
end

