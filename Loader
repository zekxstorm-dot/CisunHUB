-- HOOK: BILLBOARD CENTER ONLY
-- Scan HANYA ScreenGui + BillboardGui di PlayerGui yang posisinya
-- di tengah layar (AnchorPoint ~0.5 atau Position scale ~0.5)
-- ini yang admin pakai buat broadcast code
----------------------------------------------------------------

local registeredGuis = {}

local function isCenterGui(obj)
    -- Cek apakah GUI ini posisinya di tengah layar
    if obj:IsA("Frame") or obj:IsA("ScreenGui") then
        return true -- ScreenGui level frame selalu dicheck
    end
    if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
        return true
    end
    return false
end

local function hookNotifGui(gui, source)
    if registeredGuis[gui] then return end
    registeredGuis[gui]=true

    -- Hook semua TextLabel dalam gui ini
    local function hookLabel(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            -- Proses teks saat ini
            if obj.Text and obj.Text~="" then
                processText(obj.Text, source)
            end
            -- Watch perubahan teks real-time
            connect(obj:GetPropertyChangedSignal("Text"),function()
                if obj.Text~="" then
                    processText(obj.Text, source)
                end
            end)
        end
    end

    for _,desc in ipairs(gui:GetDescendants()) do hookLabel(desc) end
    connect(gui.DescendantAdded,function(desc)
        task.wait(0.05)
        hookLabel(desc)
    end)
end

-- Scan PlayerGui untuk ScreenGui baru yang muncul
-- (notifikasi/billboard admin = ScreenGui baru yang di-spawn)
local function watchPlayerGui()
    -- Scan existing ScreenGui
    for _,gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            -- Skip EclipseHub sendiri
            if gui.Name~="EclipseHub" then
                hookNotifGui(gui, "ScreenGui:"..gui.Name)
            end
        end
    end

    -- Watch ScreenGui baru yang muncul
    connect(PlayerGui.ChildAdded,function(gui)
        task.wait(0.05)
        if gui:IsA("ScreenGui") and gui.Name~="EclipseHub" then
            hookNotifGui(gui, "NewScreenGui:"..gui.Name)
        end
    end)
end

-- Scan Workspace untuk BillboardGui di karakter admin/NPC
-- yang muncul di tengah layar saat admin ngomong
local function watchWorkspaceBillboards()
    local function checkPart(obj)
        if obj:IsA("BillboardGui") then
            hookNotifGui(obj, "Billboard:"..obj.Name)
        end
    end

    -- Watch semua karakter yang ada
    local function watchCharacter(char)
        for _,obj in ipairs(char:GetDescendants()) do checkPart(obj) end
        connect(char.DescendantAdded,function(obj)
            task.wait(0.05)
            checkPart(obj)
        end)
    end

    -- Watch semua player
    for _,p in ipairs(Players:GetPlayers()) do
        if p.Character then watchCharacter(p.Character) end
        connect(p.CharacterAdded,function(char) watchCharacter(char) end)
    end
    connect(Players.PlayerAdded,function(p)
        if p.Character then watchCharacter(p.Character) end
        connect(p.CharacterAdded,function(char) watchCharacter(char) end)
    end)

    -- Watch NPC/object di workspace
    connect(game.Workspace.DescendantAdded,function(obj)
        task.wait(0.05)
        if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            hookNotifGui(obj, "WorkspaceBillboard:"..obj.Name)
        end
    end)
end

