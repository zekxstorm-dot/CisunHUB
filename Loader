-- CORE: SUBMIT CODE (v2.2 — RemoteEvent first)
----------------------------------------------------------------
submitCode = function(code)
    if not code or code=="" then return end
    if State.seen[code] then return end

    pushLog("Submitting: "..code, Theme.Gold)

    -- METHOD 1: Fire RemoteEvent langsung (paling reliable)
    local remote = getRedeemRemote()
    if remote then
        local success = false

        if remote:IsA("RemoteEvent") then
            -- Coba berbagai payload format
            local payloads = {
                {code},
                {LocalPlayer, code},
                {code, LocalPlayer},
                {LocalPlayer.Name, code},
                {code, LocalPlayer.Name},
            }
            for _,payload in ipairs(payloads) do
                pcall(function() remote:FireServer(table.unpack(payload)) end)
                task.wait(0.05)
            end
            success = true
            pushLog("Remote fired: "..remote:GetFullName(), Theme.AccentSoft)

        elseif remote:IsA("RemoteFunction") then
            local results = {}
            local tries = {
                function() return remote:InvokeServer(code) end,
                function() return remote:InvokeServer(LocalPlayer, code) end,
                function() return remote:InvokeServer(code, LocalPlayer.Name) end,
            }
            for _,fn in ipairs(tries) do
                pcall(function() table.insert(results, fn()) end)
                task.wait(0.05)
            end
            success = true
            pushLog("RemoteFunction invoked", Theme.AccentSoft)
        end

        if success then
            State.seen[code] = true
            State.redeemed   = State.redeemed + 1
            setStats()
            pushLog("REDEEMED: "..code, Theme.Good)
            return
        end
    end

    -- METHOD 2: Fallback UI injection
    local function findCodeUI()
        local box, btn = nil, nil
        for _,obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if obj:IsA("TextBox") and not box then
                if obj.PlaceholderText:lower():find("code") then box=obj end
            end
            if (obj:IsA("TextButton") or obj:IsA("GuiButton")) and not btn then
                local tx=obj.Text:lower()
                if tx:find("submit") or tx:find("redeem") or tx:find("confirm") then btn=obj end
            end
            if box and btn then break end
        end
        return box, btn
    end

    local box, btn = findCodeUI()
    if not box then
        -- Auto-open panel Kode
        for _,obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local tx=(obj.Text or ""):lower()
                local nm=obj.Name:lower()
                if tx:find("kode") or tx:find("code") or nm:find("kode") or nm:find("code") or nm:find("123") then
                    pcall(function() obj.MouseButton1Click:Fire() end)
                    task.wait(0.4)
                    break
                end
            end
        end
        box, btn = findCodeUI()
    end

    if box then
        pcall(function()
            box:CaptureFocus()
            box.Text = code
            box.FocusLost:Fire(true)
        end)
        task.wait(0.08)
        if btn then
            pcall(function() btn.MouseButton1Click:Fire() end)
            pcall(function() btn.MouseButton1Down:Fire() task.wait(0.02) btn.MouseButton1Up:Fire() end)
        end
        State.seen[code] = true
        State.redeemed   = State.redeemed + 1
        setStats()
        pushLog("REDEEMED via UI: "..code, Theme.Good)
    else
        pushLog("FAILED — buka panel Kode dulu", Theme.Bad)
    end
end

