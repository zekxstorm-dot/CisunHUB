-- CORE: FIND REDEEM REMOTE (HARDCODED v2.2)
----------------------------------------------------------------
local function getRedeemRemote()
    -- Primary: StockEventService/Redeem (confirmed dari scan)
    local net = ReplicatedStorage:FindFirstChild("Packages")
        and ReplicatedStorage.Packages:FindFirstChild("Net")
    if net then
        local re = net:FindFirstChild("RE")
        if re then
            local stock = re:FindFirstChild("StockEventService")
            if stock then
                local redeem = stock:FindFirstChild("Redeem")
                if redeem then return redeem end
            end
        end
    end
    -- Fallback: deep search keyword
    local function deepFind(parent, depth)
        if depth > 6 then return nil end
        for _, obj in ipairs(parent:GetChildren()) do
            if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
                local n = obj.Name:lower()
                if n:find("redeem") or n:find("code") or n:find("promo") then
                    return obj
                end
            end
            local found = deepFind(obj, depth+1)
            if found then return found end
        end
        return nil
    end
    return deepFind(ReplicatedStorage, 0)
end

