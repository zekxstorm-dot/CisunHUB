        end
    end)

    -- LAYER 3: Direct inject backup
    task.spawn(function()
        task.wait(0.9)
        local box,btn=nil,nil
        for _,obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if obj:IsA("TextBox") and not box then
                if (obj.PlaceholderText or ""):lower():find("code") then box=obj end
            end
            if (obj:IsA("TextButton") or obj:IsA("GuiButton")) and not btn then
                local tx=(obj.Text or ""):lower()
                if tx:find("submit") or tx:find("redeem") then btn=obj end
            end
            if box and btn then break end
        end
        if box then
            pcall(function() box:CaptureFocus() box.Text=code box.FocusLost:Fire(true) end)
            task.wait(0.08)
            if btn then
                pcall(function() btn.MouseButton1Down:Fire() task.wait(0.03) btn.MouseButton1Up:Fire() btn.MouseButton1Click:Fire() end)
