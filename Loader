local function selectTab(name)
    if currentTab==name then return end
    currentTab=name
    for n,t in pairs(TabButtons) do
        local active=n==name
        tween(t.btn,{BackgroundTransparency=active and 0 or 1})
        tween(t.label,{TextColor3=active and Theme.Text or Theme.Sub})
        tween(t.bar,{Size=active and UDim2.fromOffset(3,16) or UDim2.fromOffset(3,0),BackgroundTransparency=active and 0 or 1})
        PageFrames[n].Visible=active
    end
end

local function addTab(name,order)
    local btn=new("TextButton",{Size=UDim2.new(1,0,0,34),BackgroundColor3=Theme.Card,BackgroundTransparency=1,Text="",AutoButtonColor=false,LayoutOrder=order,Parent=TabList},{corner(9)})
