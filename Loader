-- CORE: AUTO PART DETECTOR
----------------------------------------------------------------
local function detectPartCount(text)
    local lo=text:lower()
    local num=lo:match("(%d+)%s*parts?") or lo:match("(%d+)%s*bagian") or lo:match("(%d+)%s*kata") or lo:match("(%d+)%s*words?")
    if num then return tonumber(num) end
    local wordNums={one=1,two=2,three=3,four=4,five=5,satu=1,dua=2,tiga=3,empat=4,lima=5}
    for word,count in pairs(wordNums) do
        if lo:find(word.."%s*parts?") or lo:find(word.."%s*bagian") then return count end
    end
    if lo:find("no number") or lo:find("without number") or lo:find("tanpa angka") or lo:find("tanpa nomor") then return 2 end
    if lo:find("has number") or lo:find("with number") or lo:find("ada angka") or lo:find("ada nomor") then return 3 end
    return nil
end

----------------------------------------------------------------
-- CORE: SIGNAL + PART LOGIC
----------------------------------------------------------------
local SIGNAL_WORDS={"use","code","this","has","numbers","redeem","here","from","sammy","dlc","any","or","the","and","a","an","is","are","kode","gunakan","pakai","masukkan","angka","nomor","ini","tanpa","without","no"}

local function isSignalWord(w)
    for _,sw in ipairs(SIGNAL_WORDS) do if w:lower()==sw then return true end end
    return false
end

local function isCodeSignal(text)
    local lo=text:lower()
    return lo:find("use code") or lo:find("code is") or lo:find("this code")
        or lo:find("kode") or lo:find("redeem") or lo:find("gunakan")
        or lo:find("has number") or lo:find("ada angka")
        or lo:find("no number") or lo:find("tanpa angka")
        or lo:find("without number") or lo:find("parts")
        or lo:find("bagian") or lo:find("sammy")
end

local function extractPart(text)
    if not text or #text<1 or #text>30 then return nil end
    local clean=text:match("^%s*(.-)%s*$")
    if clean=="" then return nil end
    if clean:match("^[%w%-_]+$") and #clean>=1 and #clean<=20 then
        if not isSignalWord(clean) then return clean:upper() end
    end
    return nil
end

local function resetParts()
    State.parts={}
    State.collecting=false
    PartStatus.Text="Waiting..."
    PartStatus.TextColor3=Theme.Sub
end

local function addPart(part)
    if not State.enabled then return end
    for _,p in ipairs(State.parts) do if p==part then return end end
    if not State.collecting then State.collecting=true State.parts={} end
    table.insert(State.parts,part)
    State.lastPartTime=os.clock()
    PartStatus.Text=#State.parts.."/"..State.partTarget.." → "..table.concat(State.parts," + ")
    PartStatus.TextColor3=Theme.Gold
    pushLog("Part "..#State.parts.."/"..State.partTarget..": "..part,Theme.AccentSoft)
    if #State.parts>=State.partTarget then
        local fullCode=table.concat(State.parts,"")
        pushLog("Code lengkap: "..fullCode,Theme.Good)
        PartStatus.Text="SUBMIT → "..fullCode
        PartStatus.TextColor3=Theme.Good
        State.captured=State.captured+1
        setStats()
        if State.autoSubmit then task.spawn(function() task.wait(0.1) submitCode(fullCode) end) end
        task.delay(3,resetParts)
        return
    end
    local token=State.lastPartTime
    task.spawn(function()
        task.wait(State.PART_TIMEOUT)
        if State.lastPartTime==token and State.collecting then
            pushLog("Timeout — reset",Theme.Bad)
            resetParts()
        end
    end)
end

----------------------------------------------------------------
-- CORE: PROCESS TEXT — HANYA DARI BILLBOARD TENGAH LAYAR
----------------------------------------------------------------
local function processText(text, source)
    if not State.enabled then return end
    if not text or #text<1 or #text>120 then return end
    local clean=text:match("^%s*(.-)%s*$")
    if clean=="" then return end

    -- Dedup ringan
    local key=clean:upper()
    if seenTexts[key] then return end

    -- Flush seenTexts kalau terlalu banyak
    if seenCount>MAX_SEEN then
        seenTexts={}
        seenCount=0
    end

    seenTexts[key]=true
    seenCount=seenCount+1
    task.delay(10,function()
        seenTexts[key]=nil
        seenCount=math.max(0,seenCount-1)
    end)

    -- Auto detect part count
    if State.autoDetect then
        local detected=detectPartCount(clean)
        if detected then
            updateStep(detected)
            pushLog("Auto-detect: "..detected.." parts",Theme.Gold)
            PartStatus.Text="Expecting "..detected.." parts..."
            PartStatus.TextColor3=Theme.Gold
        end
    end

    -- Signal detection
    if isCodeSignal(clean) then
        if not State.collecting then
            State.collecting=true
            State.parts={}
            pushLog("Signal: "..source,Theme.Gold)
            PartStatus.Text="Signal! Waiting "..State.partTarget.." parts..."
            PartStatus.TextColor3=Theme.Gold
        end
        -- Direct code dalam signal
        local directCode=clean:upper():match("USE%s+CODE[%s:]+([%w%-_]+)")
            or clean:upper():match("CODE%s+IS[%s:]+([%w%-_]+)")
            or clean:upper():match("REDEEM[%s:]+([%w%-_]+)")
        if directCode and #directCode>=3 and not State.seen[directCode] then
            pushLog("Direct code: "..directCode,Theme.AccentSoft)
            State.captured=State.captured+1
            setStats()
            if State.autoSubmit then task.spawn(function() submitCode(directCode) end) end
        end
        return
    end

    -- Collecting mode
    if State.collecting then
        local part=extractPart(clean)
        if part then addPart(part) end
    end
end

