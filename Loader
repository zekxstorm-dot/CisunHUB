submitCode=function(code)
    if not code or code=="" then return end
    if State.seen[code] then pushLog("Already redeemed: "..code,Theme.Sub) return end

    pushLog(">>> SUBMITTING: "..code,Theme.Gold)

    -- LAYER 1: RemoteEvent
    task.spawn(function()
        local remote=getRedeemRemote()
        if remote then
            local payloads={{code},{LocalPlayer,code},{code,LocalPlayer},{LocalPlayer.Name,code},{code,LocalPlayer.Name},{LocalPlayer.UserId,code}}
            for _,payload in ipairs(payloads) do
                pcall(function()
                    if remote:IsA("RemoteEvent") then remote:FireServer(table.unpack(payload))
                    else remote:InvokeServer(table.unpack(payload)) end
                end)
                task.wait(0.05)
            end
            pushLog("L1 Remote fired",Theme.AccentSoft)
        else
            pushLog("L1 Remote not found",Theme.Bad)
        end
    end)

    -- LAYER 2: Keyboard simulation
    task.spawn(function()
        task.wait(0.3)
        local function findUI()
            local box,btn=nil,nil
            for _,obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if obj:IsA("TextBox") and not box then
